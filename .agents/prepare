#!/bin/sh
# Delta 在挂载 managed checkout 后、agent 启动前运行本脚本(.agents/prepare)。
# 依赖版本由已提交的 bun.lock 锁定;脚本需幂等、非交互。
set -eu

# bun 缺失时尽力安装(优先 npm 全局包,失败则给出明确提示)
if ! command -v bun >/dev/null 2>&1; then
	if command -v npm >/dev/null 2>&1; then
		npm install -g bun
	else
		echo "bun not found and npm unavailable; install bun from https://bun.sh first" >&2
		exit 1
	fi
fi

bun install
