{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ESNext"],
		"types": ["node"],
		"strict": true,
		"noImplicitAny": false,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"isolatedModules": true
	},
	"include": ["omp-delta.ts", "tests/**/*.ts"]
}
